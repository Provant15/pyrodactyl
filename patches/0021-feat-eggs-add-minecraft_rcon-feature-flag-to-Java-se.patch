Subject: [PATCH 21/21] feat(eggs): add minecraft_rcon feature flag to Java
 server eggs

Enables the Players page for all RCON-capable Minecraft server
types. Added to seed JSON so the flag survives container restarts.

diff --git a/database/Seeders/eggs/minecraft/egg-fabric.json b/database/Seeders/eggs/minecraft/egg-fabric.json
index dd8ef3e92..9dc4f4b86 100644
--- a/database/Seeders/eggs/minecraft/egg-fabric.json
+++ b/database/Seeders/eggs/minecraft/egg-fabric.json
@@ -14,7 +14,8 @@
         "pid_limit",
         "mod/fabric",
         "mclogs",
-        "subdomain_minecraft"
+        "subdomain_minecraft",
+        "minecraft_rcon"
     ],
     "docker_images": {
         "Java 25": "ghcr.io/pyrodactyl-oss/images:java_25",
