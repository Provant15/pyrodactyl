From 3dff291619f1a6beee32c9353837681723c9ba6c Mon Sep 17 00:00:00 2001
From: Provant15 <me@provant.dev>
Date: Fri, 6 Mar 2026 19:47:21 +1000
Subject: [PATCH 06/18] feat(db-hosts): wire driver through API validators,
 transformers, and controllers

Make the remote field optional for PostgreSQL database hosts across all
API layers. PostgreSQL does not use MySQL-style user@host grants, so
requiring a remote connection string is incorrect for pgsql hosts.

- DeployServerDatabaseService: remove Assert on remote, default to '%'
- Database model: change remote rule to sometimes|required
- Admin StoreServerDatabaseRequest: conditionally require remote based
  on the selected host's driver via prepareForValidation()
- App API StoreServerDatabaseRequest: make remote sometimes|nullable,
  default to '%' in validated()
- Client DatabaseTransformer: expose driver in host sub-object
- App DatabaseHostTransformer: expose driver field
- Admin ServersController: default remote to '%' when not provided

diff --git a/app/Http/Controllers/Admin/ServersController.php b/app/Http/Controllers/Admin/ServersController.php
index 73bb7624e..76679a9eb 100644
--- a/app/Http/Controllers/Admin/ServersController.php
+++ b/app/Http/Controllers/Admin/ServersController.php
@@ -206,7 +206,7 @@ class ServersController extends Controller
     {
         $this->databaseManagementService->create($server, [
             'database' => DatabaseManagementService::generateUniqueDatabaseName($request->input('database'), $server->id),
-            'remote' => $request->input('remote'),
+            'remote' => $request->input('remote', '%'),
             'database_host_id' => $request->input('database_host_id'),
             'max_connections' => $request->input('max_connections'),
         ]);
