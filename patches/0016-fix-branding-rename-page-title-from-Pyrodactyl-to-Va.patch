Subject: [PATCH 16/21] fix(branding): rename page title from Pyrodactyl to
 Valhalla

Update PageContentBlock.tsx document title suffix and add to
branding patch (0010) to keep patch and source in sync.

diff --git a/resources/scripts/components/elements/PageContentBlock.tsx b/resources/scripts/components/elements/PageContentBlock.tsx
index e9e4d75c2..62f96a653 100644
--- a/resources/scripts/components/elements/PageContentBlock.tsx
+++ b/resources/scripts/components/elements/PageContentBlock.tsx
@@ -13,7 +13,7 @@ export interface PageContentBlockProps {
 const PageContentBlock: React.FC<PageContentBlockProps> = ({ title, showFlashKey, className, children }) => {
     useEffect(() => {
         if (title) {
-            document.title = title + ' | Pyrodactyl';
+            document.title = title + ' | Valhalla';
         }
     }, [title]);
 
